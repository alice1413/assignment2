{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "assignment02",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}

